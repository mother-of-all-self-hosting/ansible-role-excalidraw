FROM --platform=${BUILDPLATFORM} node:24 AS build

WORKDIR /opt/node_app

# Copy the application source code
COPY . .

RUN --mount=type=cache,target=/root/.cache/yarn \
    yarn --network-timeout 600000

ARG NODE_ENV=production

# Build the application
RUN npm_config_target_arch=${TARGETARCH} yarn build:app:docker

{#
  Excalidraw's own Dockerfile finishes with nginx, which needs to start as root.
  Static Web Server serves the same files as an unprivileged user with a read-only
  root filesystem, which is how `../templates/systemd/excalidraw.service.j2` runs it.
  Its configuration arrives through the SERVER_* variables in `../templates/env.j2`.
#}
FROM {{ excalidraw_container_image_self_build_base_image }}

COPY --from=build /opt/node_app/excalidraw-app/build {{ excalidraw_environment_variables_server_root }}

EXPOSE "{{ excalidraw_container_http_port }}"
